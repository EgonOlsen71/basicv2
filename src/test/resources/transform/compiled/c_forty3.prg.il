PROGRAMSTART:
JSR START
0:
10:
NOP
MOV Y,#-1.0{REAL}
MOV P{REAL},Y
NOP
MOV Y,#0{INTEGER}
MOV I{REAL},Y
NOP
MOV Y,#4{INTEGER}
PUSH Y
NOP
MOV Y,#1{INTEGER}
PUSH Y
MOV A,(I{REAL})
JSR INITFOR
20:
NOP
MOV X,I{REAL}
JSR REALOUT
JSR CRSRRIGHT
NOP
JMP 50
50:
NOP
MOV A,#0{INTEGER}
JSR NEXT
CMP A,#0{INTEGER}
JE ($JUMP)
NOP
MOV Y,#6{INTEGER}
MOV X,I{REAL}
LT X,Y
CMP X,#0{REAL}
JNE NSKIP0
JMP SKIP0
NSKIP0:
JMP 100
NOP
SKIP0:
60:
NOP
MOV Y,#-1.0{REAL}
MOV X,P{REAL}
EQ X,Y
CMP X,#0{REAL}
JNE NSKIP1
JMP SKIP1
NSKIP1:
NOP
MOV Y,#11{INTEGER}
MOV P{REAL},Y
NOP
MOV Y,#12{INTEGER}
PUSH Y
NOP
MOV Y,#1{INTEGER}
PUSH Y
MOV A,(P{REAL})
JSR INITFOR
NOP
MOV X,P{REAL}
JSR REALOUT
JSR CRSRRIGHT
JMP 50
NOP
SKIP1:
70:
NOP
MOV A,#end!{STRING}
JSR STROUT
JSR LINEBREAK
NOP
JSR END
RTS
100:
NOP
MOV Y,#5{INTEGER}
MOV I{REAL},Y
NOP
MOV Y,#10{INTEGER}
PUSH Y
NOP
MOV Y,#1{INTEGER}
PUSH Y
MOV A,(I{REAL})
JSR INITFOR
NOP
MOV X,I{REAL}
JSR REALOUT
JSR CRSRRIGHT
NOP
JMP 50
NOP
JSR END
RTS
